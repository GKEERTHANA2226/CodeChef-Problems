def get_expenses_list():

    file_path = "/home/chef/workspace/myExpenses.txt"

    # Open the file in read mode and read all lines
    with open(file_path, "r") as file:
        expenses = file.readlines()

    # Initialized an empty list to store filtered expenses
    filtered_list = []    

    # Iterate through each expense and remove newline characters
    for i in expenses:
        filtered_list.append(i.strip("\n"))

    # Return the cleaned list of expenses
    return filtered_list


if __name__ == '__main__':
    # Get the filtered list of expenses
    expense_list = get_expenses_list()
        
    # Print the list
    print(expense_list)
