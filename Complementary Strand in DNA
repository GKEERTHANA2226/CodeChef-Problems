# cook your dish here
import sys

def solve():
    input = sys.stdin.read
    data = input().split()
    
    if not data:
        return
    
    T = int(data[0])
    idx = 1
    mapping = str.maketrans("ATCG", "TAGC")
    
    out = []
    for _ in range(T):
        N = int(data[idx])
        S = data[idx+1]
        idx += 2
        out.append(S.translate(mapping))
        
    print('\n'.join(out))

if __name__ == '__main__':
    solve()
