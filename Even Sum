t = int(input())

for _ in range(t):
    n = int(input())
    arr = list(map(int, input().split()))

    total = sum(arr)

    if total % 2 == 0:
        if any(x % 2 == 0 for x in arr):
            print("Yes")
        else:
            print("No")
    else:
        if any(x % 2 == 1 for x in arr):
            print("Yes")
        else:
            print("No")
