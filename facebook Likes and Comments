t = int(input())
for _ in range(t):
    n = int(input())
    a = list(map(int, input().split()))
    b = list(map(int, input().split()))
    best = 0
    for i in range(1,n):
        if a[i] > a[best]:
            best = i 
        elif a[i] == a[best]:
            if b[i] > b[best]:
                best = i 
    print(best + 1)
        
        
