t = int(input())
for _ in range(t):
    N = int(input())
    A = list(map(int,input().split()))
    freq = {}
    for x in A:
        freq[x] = freq.get(x,0)+1
        maximum = max(freq.values())
    count = 0
    for key in freq:
        if freq[key] == maximum:
            count += 1
    if count == 1:
        print("YES")
    else:
        print("NO")
