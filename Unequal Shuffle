import sys

def solve():
    input = sys.stdin.read
    data = input().split()
    if not data:
        return
    t = int(data[0])
    idx = 1
    out = []
    for _ in range(t):
        n = int(data[idx])
        a = data[idx + 1]
        b = data[idx + 2]
        idx += 3
        cntA_a = a.count('a')
        cntB_a = b.count('a')
        if cntA_a + cntB_a == n:
            out.append("YES")
        else:
            out.append("NO")
            
    print('\n'.join(out))

if __name__ == '__main__':
    solve()
